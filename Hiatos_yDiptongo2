<body>
<div class="shell">
<header>
  <div class="brand"><div class="logo" aria-hidden="true">🌈</div><div><h1>Aventura de vocales</h1><p>Jugamos con los hiatos y los diptongos, Gabriel</p></div></div>
  <div class="tools"><div class="pill" id="combocount">8 combinaciones</div><button class="toolbtn" id="soundBtn" aria-pressed="true">🔊 Voz activada</button><button class="toolbtn" id="settingsBtn">⚙️ Configurar</button></div>
</header>
<nav aria-label="Elegir juego">
<button type="button" class="tab active" data-tab="1"><span class="tabicon" aria-hidden="true">🐰</span>1. Atrapa vocales</button>
<button type="button" class="tab" data-tab="2"><span class="tabicon" aria-hidden="true">📦</span>2. Clasifica</button>
<button type="button" class="tab" data-tab="3"><span class="tabicon" aria-hidden="true">👆</span>3. Aprende</button>
<button type="button" class="tab" data-tab="4"><span class="tabicon" aria-hidden="true">🔎</span>4. Palabras</button>
