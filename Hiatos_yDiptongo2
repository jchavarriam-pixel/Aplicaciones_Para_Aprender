function changeTab(n){clearTimeout(timeoutId);app.catch.busy=false;app.sort.busy=false;app.word.busy=false;app.tab=n;resetFeedback();document.querySelectorAll('.tab').forEach(b=>{b.classList.toggle('active',+b.dataset.tab===n);b.setAttribute('aria-current',+b.dataset.tab===n?'page':'false')});render()}
function otherThan(list,old){const choices=list.filter(v=>v.key!==old);return rnd(choices.length?choices:list)}
function newCatch(){const es=useEntries();const prev=app.catch.pairs;const a=otherThan(es.filter(x=>x.type==='d'),prev.find(x=>x.type==='d')?.key),b=otherThan(es.filter(x=>x.type==='h'),prev.find(x=>x.type==='h')?.key);app.catch.pairs=shuffle([a,b]);app.catch.busy=false;app.picked=null}
