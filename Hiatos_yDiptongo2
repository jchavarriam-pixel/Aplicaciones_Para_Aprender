$('#settingsBtn').addEventListener('click',openSettings);$('#closeSettings').addEventListener('click',closeSettings);$('#settingsOverlay').addEventListener('click',e=>{if(e.target===$('#settingsOverlay'))closeSettings()});window.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('#settingsOverlay').hidden)closeSettings()});
$('#blockList').addEventListener('change',e=>{const x=e.target.closest('[data-option]');if(!x)return;const k=x.dataset.option;draft=x.checked?[...draft.filter(y=>y!==k),k]:draft.filter(y=>y!==k);renderSettings()});$('#blockList').addEventListener('click',e=>{const x=e.target.closest('[data-block]');if(!x)return;const b=BLOCKS.find(v=>v.id===x.dataset.block);const all=b.items.every(i=>draft.includes(i[0]));draft=all?draft.filter(k=>!b.items.some(it=>it[0]===k)):[...new Set([...draft,...b.items.map(i=>i[0])])];renderSettings()});
