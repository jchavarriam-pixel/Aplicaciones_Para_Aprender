function renderCatch(){const pairs=app.catch.pairs;area.innerHTML=heading('🐰 Atrapa las vocales','Atrapa cada animalito y llévalo a su corral. También puedes tocar el animalito y después tocar un corral.')+
`<div class="land"><button class="pen d target" data-target="d" type="button"><span class="penicon">🏡</span><strong>Diptongos</strong><small>Vocales juntas</small><span class="arrow">Toca aquí →</span></button><div class="field"><div class="cloud" aria-hidden="true">☁</div><div class="grass" aria-hidden="true">🌱</div>${pairs.map((e,i)=>`<button class="critter draggable ${i?'alt':''} ${app.picked===e.key?'picked':''}" type="button" data-key="${esc(e.key)}" data-game="1" aria-label="Atrapar ${esc(e.key)}"><div class="eyes" aria-hidden="true"><span></span><span></span></div><div class="cheeks" aria-hidden="true"><i></i><i></i></div><span class="nose" aria-hidden="true">●</span><span class="animalcombo">${esc(e.key)}</span></button>`).join('')}</div><button class="pen h target" data-target="h" type="button"><span class="penicon">🏡</span><strong>Hiatos</strong><small>Vocales separadas</small><span class="arrow">← Toca aquí</span></button></div>`+feedbackHTML()+`<div class="gameactions"><button class="outlinebtn" data-action="newcatch">🔄 Otros animalitos</button><button class="outlinebtn" data-action="score">↺ Reiniciar puntos</button></div>`}
function chooseCatch(key,target){if(app.catch.busy)return;const item=app.catch.pairs.find(x=>x.key===key);if(!item)return;app.catch.busy=true;app.picked=null;const right=item.type===target;app.stats[1][right?'ok':'err']++;setFeedback(right?correct(item):incorrect(item));const critter=[...area.querySelectorAll('.critter')].find(x=>x.dataset.key===key);if(critter)critter.classList.add(right?'win':'escape');if(!right)area.querySelectorAll('.critter').forEach(c=>c.classList.add('escape'));timeoutId=setTimeout(()=>{newCatch();renderCatch()},right?1250:1900)}
function renderSort(){const s=app.sort;if(!s.pending.length&&!s.remaining.length){area.innerHTML=heading('📦 Clasifica las combinaciones','Terminaste todas las combinaciones seleccionadas.')+`<div class="completion"><div class="party">🎉</div><h3>¡Excelente trabajo, Gabriel!</h3><p>Clasificaste ${s.done} combinaciones. ¿Quieres jugar otra vez?</p><button class="primarybtn" data-action="newsort">🔄 Jugar de nuevo</button></div>`+feedbackHTML();return}
area.innerHTML=heading('📦 Clasifica las combinaciones','Arrastra cada combinación del centro hacia la izquierda si es diptongo o hacia la derecha si es hiato. También puedes tocar primero la ficha.')+
`<div class="sorting"><button type="button" class="sort-target d target" data-target="d"><span class="sortpic">🔗</span><strong>Diptongos</strong><span class="hintsmall">Vocales juntas</span></button><div class="sort-col"><h3>COMBINACIONES</h3>${s.pending.map(it=>`<button type="button" class="sort-item draggable ${app.picked===it.key?'picked':''}" data-key="${esc(it.key)}" data-game="2">${esc(it.key)}</button>`).join('')}<div class="sort-note">Toca una ficha y después su clasificación.</div></div><button type="button" class="sort-target h target" data-target="h"><span class="sortpic">↔️</span><strong>Hiatos</strong><span class="hintsmall">Vocales separadas</span></button></div><div class="progress" aria-label="Progreso"><span style="width:${Math.round(s.done/Math.max(s.total,1)*100)}%"></span></div><div class="minihelp">${s.done} de ${s.total} combinaciones clasificadas</div>`+feedbackHTML()+`<div class="gameactions"><button class="outlinebtn" data-action="newsort">🔄 Mezclar fichas</button><button class="outlinebtn" data-action="score">↺ Reiniciar puntos</button></div>`}
function chooseSort(key,target){const s=app.sort;if(s.busy)return;const it=s.pending.find(x=>x.key===key);if(!it)return;app.picked=null;const right=it.type===target;app.stats[2][right?'ok':'err']++;if(right){s.done++;s.pending=s.pending.filter(x=>x.key!==key);if(!s.pending.length&&s.remaining.length){s.pending=s.remaining.slice(0,8);s.remaining=s.remaining.slice(8)}}setFeedback(right?correct(it):incorrect(it));renderSort()}
function renderStudy(){const list=useEntries();area.innerHTML=heading('👆 Aprende las combinaciones','Toca cualquier tarjeta para escuchar cómo se llama. Observa: en un diptongo las vocales van juntas; en un hiato se separan.')+
`<div class="studylayout">${['d','h'].map(type=>`<section class="studygroup ${type}"><h3>${type==='d'?'🔗 Diptongos':'↔️ Hiatos'}</h3><p>${type==='d'?'Dos vocales dentro de una misma sílaba.':'Dos vocales que quedan en sílabas diferentes.'}</p><div class="studygrid">${list.filter(x=>x.type===type).map(it=>`<button class="studycard ${app.studyPicked===it.key?'selected':''}" type="button" data-study="${esc(it.key)}"><strong>${esc(it.key)}</strong><span>🔊 Escuchar</span></button>`).join('')}</div></section>`).join('')}</div>`+feedbackHTML()+`<div class="studylegend">💡 Una <strong>i</strong> o una <strong>u</strong> con tilde puede separar las vocales: <strong>ía</strong> es hiato, mientras que <strong>ia</strong> es diptongo.</div>`}
function studyClick(key){const it=byKey[key];if(!it)return;app.studyPicked=key;const same=it.type==='d';app.message={tone:'good',html:`<b>${letterHTML(it)}</b> es un <strong>${cat(it.type)}</strong>. Las vocales ${reason(it)}. Por ejemplo: <strong>${esc(it.word)}</strong> (${esc(it.syll)}).`,voice:`Es un ${cat(it.type)}. La ${letterNames(it)} ${reason(it)}. Por ejemplo, ${it.word}.`};renderStudy();speech(app.message.voice)}
function renderWord(){const w=app.word;if(w.idx>=w.words.length){area.innerHTML=heading('🔎 Clasifica palabras','¡Completaste las palabras del grupo que escogiste!')+`<div class="completion"><div class="party">🏆</div><h3>¡Lo lograste, Gabriel!</h3><p>Clasificaste ${w.words.length} palabras. Puedes repetir el juego o escoger otras combinaciones en Configuración.</p><button class="primarybtn" data-action="newwords">🔄 Jugar otra vez</button></div>`+feedbackHTML();return}
const it=w.words[w.idx];const idx=it.word.indexOf(it.match);let showing=esc(it.word);if(app.highlight&&idx>=0)showing=esc(it.word.slice(0,idx))+`<mark>${esc(it.match)}</mark>`+esc(it.word.slice(idx+it.match.length));
area.innerHTML=heading('🔎 Clasifica palabras','Lee la palabra. Decide si las vocales marcadas forman un hiato o un diptongo. Puedes quitar la ayuda cuando estés listo.')+
`<div class="wordcount">Palabra ${w.idx+1} de ${w.words.length}</div><div class="wordbox"><div class="overline">¿Hiato o diptongo?</div><div class="theword">${showing}</div><div class="togglewrap"><button type="button" id="highlightBtn" class="toggle ${app.highlight?'on':''}" role="switch" aria-checked="${app.highlight}" aria-label="Mostrar u ocultar las vocales resaltadas"></button><span>${app.highlight?'Mostrar ayuda: activada':'Mostrar ayuda: desactivada'}</span></div></div><div class="wordchoices"><button class="choice" type="button" data-wordchoice="d">🔗 Diptongo</button><button class="choice h" type="button" data-wordchoice="h">↔️ Hiato</button></div>`+feedbackHTML()+`<div class="gameactions"><button class="outlinebtn" data-action="newwords">🔄 Empezar de nuevo</button><button class="outlinebtn" data-action="score">↺ Reiniciar puntos</button></div>`}
function wordGuess(target){const w=app.word;if(w.busy||w.idx>=w.words.length)return;const it=w.words[w.idx];const right=it.type===target;app.stats[4][right?'ok':'err']++;if(right){w.busy=true;setFeedback({tone:'good',html:`¡Excelente, Gabriel! En <strong>${esc(it.word)}</strong>, <b>${letterHTML(it)}</b> es un <strong>${cat(it.type)}</strong>. Se divide así: <strong>${esc(it.syll)}</strong>.`,voice:`¡Excelente, Gabriel! ${it.word} tiene un ${cat(it.type)}. Se divide así: ${it.syll.replaceAll('-',' ... ')}.`});timeoutId=setTimeout(()=>{w.idx++;w.busy=false;app.message=null;renderWord()},1800)}else{setFeedback({tone:'bad',html:`No, no, no, Gabriel. En <strong>${esc(it.word)}</strong>, <b>${letterHTML(it)}</b> es un <strong>${cat(it.type)}</strong>. Mira: <strong>${esc(it.syll)}</strong>; sus vocales ${reason(it)}. ¡Intenta otra vez!`,voice:`No, no, no, Gabriel. En la palabra ${it.word}, es un ${cat(it.type)}. Las vocales ${reason(it)}. Inténtalo otra vez.`})}}
// Interacción accesible: arrastrar con mouse o dedo, o tocar primero la tarjeta y luego la categoría.
area.addEventListener('pointerdown',e=>{const el=e.target.closest('.draggable');if(!el||app.catch.busy||app.sort.busy||app.word.busy||!e.isPrimary)return;const rect=el.getBoundingClientRect();drag={el,game:+el.dataset.game,key:el.dataset.key,id:e.pointerId,startX:e.clientX,startY:e.clientY,offsetX:e.clientX-rect.left,offsetY:e.clientY-rect.top,rect,ghost:null,moved:false};try{el.setPointerCapture(e.pointerId)}catch{}});
area.addEventListener('pointermove',e=>{if(!drag||e.pointerId!==drag.id)return;const dx=e.clientX-drag.startX,dy=e.clientY-drag.startY;if(!drag.moved&&Math.hypot(dx,dy)>9){drag.moved=true;drag.ghost=drag.el.cloneNode(true);drag.ghost.classList.add('ghost');drag.ghost.classList.remove('picked');drag.ghost.style.width=drag.rect.width+'px';drag.ghost.style.height=drag.rect.height+'px';document.body.appendChild(drag.ghost);drag.el.style.opacity='.34'}if(!drag.moved)return;e.preventDefault();drag.ghost.style.left=(e.clientX-drag.offsetX)+'px';drag.ghost.style.top=(e.clientY-drag.offsetY)+'px';area.querySelectorAll('.target').forEach(t=>{const r=t.getBoundingClientRect();t.classList.toggle('hover',e.clientX>=r.left&&e.clientX<=r.right&&e.clientY>=r.top&&e.clientY<=r.bottom)})});
function dropDrag(e){if(!drag||e.pointerId!==drag.id)return;const d=drag;drag=null;try{d.el.releasePointerCapture(e.pointerId)}catch{};if(d.ghost)d.ghost.remove();d.el.style.opacity='';area.querySelectorAll('.target').forEach(t=>t.classList.remove('hover'));if(!d.moved)return;ignoreClickUntil=Date.now()+350;const targets=[...area.querySelectorAll('.target')];const dest=targets.find(t=>{const r=t.getBoundingClientRect();return e.clientX>=r.left&&e.clientX<=r.right&&e.clientY>=r.top&&e.clientY<=r.bottom});if(dest){if(d.game===1)chooseCatch(d.key,dest.dataset.target);else chooseSort(d.key,dest.dataset.target)}}
area.addEventListener('pointerup',dropDrag);area.addEventListener('pointercancel',e=>{if(!drag)return;const d=drag;drag=null;if(d.ghost)d.ghost.remove();d.el.style.opacity='';area.querySelectorAll('.target').forEach(t=>t.classList.remove('hover'))});
area.addEventListener('click',e=>{if(Date.now()<ignoreClickUntil){e.preventDefault();return}const action=e.target.closest('[data-action]');if(action){const name=action.dataset.action;clearTimeout(timeoutId);app.catch.busy=false;app.word.busy=false;if(name==='newcatch'){newCatch();app.message=null;renderCatch()}else if(name==='newsort'){startSort();app.message=null;renderSort()}else if(name==='newwords'){startWord();app.message=null;renderWord()}else if(name==='score'){app.stats[app.tab]={ok:0,err:0};app.message=null;render()}return}const item=e.target.closest('.draggable');if(item){if(app.catch.busy||app.sort.busy)return;app.picked=app.picked===item.dataset.key?null:item.dataset.key;if(app.tab===1)renderCatch();else if(app.tab===2)renderSort();return}const target=e.target.closest('.target');if(target){if(!app.picked){setFeedback({tone:'',html:'Primero toca un animalito o una combinación. Luego escoge el corral.'});return}if(app.tab===1)chooseCatch(app.picked,target.dataset.target);else if(app.tab===2)chooseSort(app.picked,target.dataset.target);return}const study=e.target.closest('[data-study]');if(study){studyClick(study.dataset.study);return}const word=e.target.closest('[data-wordchoice]');if(word){wordGuess(word.dataset.wordchoice);return}if(e.target.closest('#highlightBtn')){app.highlight=!app.highlight;save();renderWord()}});
// Configuración compartida de los cuatro juegos.
function openSettings(){draft=[...app.selected];renderSettings();$('#settingsOverlay').hidden=false;$('#settingsBtn').setAttribute('aria-expanded','true');$('#closeSettings').focus()}
