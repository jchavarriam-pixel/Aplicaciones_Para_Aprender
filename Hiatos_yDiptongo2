$('#applySettings').addEventListener('click',()=>{if(!draft.some(k=>byKey[k].type==='d')||!draft.some(k=>byKey[k].type==='h'))return;clearTimeout(timeoutId);app.selected=[...draft];app.stats={1:{ok:0,err:0},2:{ok:0,err:0},3:{ok:0,err:0},4:{ok:0,err:0}};app.catch={pairs:[],busy:false};app.sort={pending:[],remaining:[],total:0,done:0,busy:false};app.word={words:[],idx:0,busy:false};app.studyPicked=null;app.message={tone:'',html:`¡Listo! Vamos a jugar con <strong>${app.selected.length}</strong> combinaciones.`};app.picked=null;save();closeSettings();render()});
