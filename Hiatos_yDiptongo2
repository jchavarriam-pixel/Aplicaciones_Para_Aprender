  ['ae','maestro','ae','ma-es-tro'],['ao','cacao','ao','ca-ca-o'],['ea','teatro','ea','te-a-tro'],['eo','león','eó','le-ón'],['oa','koala','oa','ko-a-la'],['oe','poeta','oe','po-e-ta']]},
