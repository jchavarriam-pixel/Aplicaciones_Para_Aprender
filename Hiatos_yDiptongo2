];
const entries=BLOCKS.flatMap(b=>b.items.map(a=>({key:a[0],type:b.type,word:a[1],match:a[2],syll:a[3],rare:!!a[4],block:b.id})));const byKey=Object.fromEntries(entries.map(e=>[e.key,e]));
