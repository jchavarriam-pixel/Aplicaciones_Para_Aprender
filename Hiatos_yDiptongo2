const app={selected:validated(saved.selected),voice:saved.voice!==false,highlight:saved.highlight!==false,tab:1,stats:{1:{ok:0,err:0},2:{ok:0,err:0},3:{ok:0,err:0},4:{ok:0,err:0}},message:null,picked:null,catch:{pairs:[],busy:false},sort:{pending:[],remaining:[],total:0,done:0,busy:false},word:{words:[],idx:0,busy:false},studyPicked:null};
const $=s=>document.querySelector(s);const area=$('#gameArea');let draft=[...app.selected],drag=null,ignoreClickUntil=0,timeoutId=0;
